# Optional for manual research; required for AI drafting/probing/synthesis and speech.
# Supply the value securely in cloud environment settings or your private .env.local.
RESEARCH_AI_KEY=
RESEARCH_MODEL=gpt-4.1-mini
RESEARCH_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
RESEARCH_SPEECH_MODEL=gpt-4o-mini-tts
RESEARCH_RETENTION_DAYS=90
# Override the private database/media directory if needed.
# RESEARCH_DATA_DIR=/absolute/private/path
# Enable secure cookies for an HTTPS development deployment. Production enables them automatically.
RESEARCH_SECURE_COOKIES=false

# Hosted workspace (see docs/vercel-deployment.md). Never commit real values.
# LIBSQL_URL=libsql://your-database.turso.io
# LIBSQL_AUTH_TOKEN=
# The Vercel Turso integration provides TURSO_DATABASE_URL and TURSO_AUTH_TOKEN
# instead; these are supported directly (LIBSQL_* takes precedence).
# Attach a PRIVATE Vercel Blob store. Use its token, or OIDC with BLOB_STORE_ID.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# For local testing of private Blob storage: RESEARCH_STORAGE=blob
# First hosted owner only: generate a private code of at least 16 characters.
# RESEARCH_SETUP_CODE=

# Participant email: verified Resend domain/sender required. Never commit real keys.
# RESEND_API_KEY=
# RESEARCH_EMAIL_FROM=research@your-verified-domain.example
# RESEARCH_EMAIL_REPLY_TO=monitored-reply@your-domain.example
# Canonical public HTTPS origin for MCP OAuth discovery/consent and email links.
# RESEARCH_PUBLIC_URL=https://your-research-host.example
# RESEARCH_EMAIL_ENCRYPTION_KEY=base64-encoded-32-random-bytes
# Production requires a stable encryption key; local development generates a private key.
